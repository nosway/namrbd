# NAMRBD community edition source manifest.
#
# Format:
#   include <path>
#   exclude <path>
#
# Community is the replicated storage core edition. It includes replicated
# volume lifecycle, basic replicated snapshot/restore/read-view/CSI/discard
# documentation, basic iSCSI daemon and sbsctl iSCSI control surfaces
# with a 3-volume export cap, and shared command surfaces. EC, user-visible clone/materialize,
# advanced mobility/DR/security/performance/iSCSI scale surfaces, stale archived
# code, and legacy namrbd-meta surfaces are excluded from future public mirror
# export.

include go.mod
include go.sum
include Makefile
include mkdocs.yml
include tools/check-docs-render.py
include .gitignore
include README.md
include LICENSE
include NOTICE
include THIRD_PARTY_NOTICES.md
include CONTRIBUTING.md
include CHANGELOG.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include CODEOWNERS
include .github
include LICENSES

include cmd/namrbd-debug
